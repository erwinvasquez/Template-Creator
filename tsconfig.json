{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"],
      "@shopenlinea/commerce-runtime-contract": [
        "./packages/commerce-runtime-contract/src/index.ts"
      ],
      "fashion-atelier-v1": ["./templates/fashion-atelier-v1/src/index.ts"],
      "fashion-atelier-v1/client": ["./templates/fashion-atelier-v1/src/client.ts"],
      "fashion-atelier-v1/*": ["./templates/fashion-atelier-v1/src/*"],
      "jewelry-orion-v1": ["./templates/jewelry-orion-v1/src/index.ts"],
      "jewelry-orion-v1/client": ["./templates/jewelry-orion-v1/src/client.ts"],
      "jewelry-orion-v1/*": ["./templates/jewelry-orion-v1/src/*"],
      "academy-voxa-v1": ["./templates/academy-voxa-v1/src/index.ts"],
      "academy-voxa-v1/client": ["./templates/academy-voxa-v1/src/client.ts"],
      "academy-voxa-v1/*": ["./templates/academy-voxa-v1/src/*"],
      "fashion-celestine-v1": ["./templates/fashion-celestine-v1/src/index.ts"],
      "fashion-celestine-v1/client": ["./templates/fashion-celestine-v1/src/client.ts"],
      "fashion-celestine-v1/*": ["./templates/fashion-celestine-v1/src/*"],
      "fashion-lumen-v1": ["./templates/fashion-lumen-v1/src/index.ts"],
      "fashion-lumen-v1/client": ["./templates/fashion-lumen-v1/src/client.ts"],
      "fashion-lumen-v1/*": ["./templates/fashion-lumen-v1/src/*"],
      "fashion-velvet-v1": ["./templates/fashion-velvet-v1/src/index.ts"],
      "fashion-velvet-v1/client": ["./templates/fashion-velvet-v1/src/client.ts"],
      "fashion-velvet-v1/*": ["./templates/fashion-velvet-v1/src/*"],
      "fashion-nova-v1": ["./templates/fashion-nova-v1/src/index.ts"],
      "fashion-nova-v1/client": ["./templates/fashion-nova-v1/src/client.ts"],
      "fashion-nova-v1/*": ["./templates/fashion-nova-v1/src/*"],
      "food-trattoria-v1": ["./templates/food-trattoria-v1/src/index.ts"],
      "food-trattoria-v1/client": ["./templates/food-trattoria-v1/src/client.ts"],
      "food-trattoria-v1/*": ["./templates/food-trattoria-v1/src/*"],
      "food-cantina-v1": ["./templates/food-cantina-v1/src/index.ts"],
      "food-cantina-v1/client": ["./templates/food-cantina-v1/src/client.ts"],
      "food-cantina-v1/*": ["./templates/food-cantina-v1/src/*"],
      "food-patisserie-v1": ["./templates/food-patisserie-v1/src/index.ts"],
      "food-patisserie-v1/client": ["./templates/food-patisserie-v1/src/client.ts"],
      "food-patisserie-v1/*": ["./templates/food-patisserie-v1/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules", "hosts", "dist"]
}
