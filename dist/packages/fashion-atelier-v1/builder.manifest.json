{
  "schemaVersion": "1.0.0",
  "templateId": "fashion-atelier-v1",
  "descriptor": {
    "templateId": "atelier",
    "latestVersion": "1.3.0",
    "status": "published",
    "websiteType": "ecommerce",
    "industryTags": [
      "fashion",
      "luxury",
      "apparel"
    ],
    "displayName": {
      "es": "Atelier Moda",
      "en": "Atelier Fashion"
    },
    "description": {
      "es": "E-commerce de moda premium: tipografía editorial, hero full-bleed y catálogo de temporada.",
      "en": "Premium fashion ecommerce with editorial typography, full-bleed hero, and seasonal catalog."
    }
  },
  "manifest": {
    "pages": [
      {
        "id": "home",
        "path": "/",
        "page": "home",
        "sections": [
          {
            "id": "hero",
            "contentSlotIds": [
              "hero.headline",
              "hero.subheadline",
              "hero.image",
              "hero.ctaPrimary"
            ]
          },
          {
            "id": "collections",
            "contentSlotIds": [
              "collections.eyebrow",
              "collections.title"
            ]
          },
          {
            "id": "featured",
            "contentSlotIds": [
              "featured.eyebrow",
              "featured.title"
            ]
          },
          {
            "id": "editorial",
            "contentSlotIds": [
              "editorial.eyebrow",
              "editorial.title",
              "editorial.body",
              "editorial.image"
            ]
          },
          {
            "id": "newsletter",
            "contentSlotIds": [
              "newsletter.eyebrow",
              "newsletter.title",
              "newsletter.subtitle"
            ]
          }
        ]
      },
      {
        "id": "shop",
        "path": "/tienda",
        "page": "shop",
        "sections": [
          {
            "id": "shop",
            "contentSlotIds": [
              "shop.eyebrow",
              "shop.title",
              "shop.description"
            ]
          }
        ]
      },
      {
        "id": "product",
        "path": "/tienda/[slug]",
        "page": "product",
        "sections": [
          {
            "id": "product",
            "contentSlotIds": []
          }
        ]
      },
      {
        "id": "about",
        "path": "/nosotros",
        "page": "about",
        "sections": [
          {
            "id": "about",
            "contentSlotIds": [
              "about.intro.eyebrow",
              "about.intro.title",
              "about.intro.body",
              "about.bannerImage"
            ]
          }
        ]
      }
    ],
    "navigation": {
      "primaryFromPayload": "navigation.primary"
    },
    "themeDefaults": {
      "colors": {
        "primary": "#1C1917",
        "secondary": "#44403C",
        "cta": "#CA8A04",
        "ctaHover": "#A16207",
        "background": "#FAFAF9",
        "surface": "#F5F5F4",
        "text": "#0C0A09",
        "muted": "#57534E",
        "border": "#E7E5E4"
      }
    },
    "themeEditable": {
      "primary": true,
      "secondary": true,
      "background": true,
      "fonts": false
    },
    "capabilities": {
      "contentSupport": {
        "slotDefinitions": [
          {
            "id": "hero.headline",
            "fieldPath": "sections.hero.headline",
            "kind": "string",
            "label": "Hero headline"
          },
          {
            "id": "hero.subheadline",
            "fieldPath": "sections.hero.subheadline",
            "kind": "string",
            "label": "Hero subheadline"
          },
          {
            "id": "hero.image",
            "fieldPath": "sections.hero.image",
            "kind": "media",
            "label": "Hero image"
          },
          {
            "id": "hero.ctaPrimary",
            "fieldPath": "sections.hero.ctaPrimary",
            "kind": "link",
            "label": "Hero primary CTA"
          },
          {
            "id": "collections.eyebrow",
            "fieldPath": "sections.collections.eyebrow",
            "kind": "string",
            "label": "Collections eyebrow"
          },
          {
            "id": "collections.title",
            "fieldPath": "sections.collections.title",
            "kind": "string",
            "label": "Collections title"
          },
          {
            "id": "featured.eyebrow",
            "fieldPath": "sections.featured.eyebrow",
            "kind": "string",
            "label": "Featured eyebrow"
          },
          {
            "id": "featured.title",
            "fieldPath": "sections.featured.title",
            "kind": "string",
            "label": "Featured title"
          },
          {
            "id": "editorial.eyebrow",
            "fieldPath": "sections.editorial.eyebrow",
            "kind": "string",
            "label": "Editorial eyebrow"
          },
          {
            "id": "editorial.title",
            "fieldPath": "sections.editorial.title",
            "kind": "string",
            "label": "Editorial title"
          },
          {
            "id": "editorial.body",
            "fieldPath": "sections.editorial.body",
            "kind": "text",
            "label": "Editorial body"
          },
          {
            "id": "editorial.image",
            "fieldPath": "sections.editorial.image",
            "kind": "media",
            "label": "Editorial image"
          },
          {
            "id": "newsletter.eyebrow",
            "fieldPath": "sections.newsletter.eyebrow",
            "kind": "string",
            "label": "Newsletter eyebrow"
          },
          {
            "id": "newsletter.title",
            "fieldPath": "sections.newsletter.title",
            "kind": "string",
            "label": "Newsletter title"
          },
          {
            "id": "newsletter.subtitle",
            "fieldPath": "sections.newsletter.subtitle",
            "kind": "string",
            "label": "Newsletter subtitle"
          },
          {
            "id": "shop.eyebrow",
            "fieldPath": "sections.shop.eyebrow",
            "kind": "string",
            "label": "Shop eyebrow"
          },
          {
            "id": "shop.title",
            "fieldPath": "sections.shop.title",
            "kind": "string",
            "label": "Shop title"
          },
          {
            "id": "shop.description",
            "fieldPath": "sections.shop.description",
            "kind": "text",
            "label": "Shop description"
          },
          {
            "id": "about.intro.eyebrow",
            "fieldPath": "sections.about.intro.eyebrow",
            "kind": "string",
            "label": "About eyebrow"
          },
          {
            "id": "about.intro.title",
            "fieldPath": "sections.about.intro.title",
            "kind": "string",
            "label": "About title"
          },
          {
            "id": "about.intro.body",
            "fieldPath": "sections.about.intro.body",
            "kind": "text",
            "label": "About body"
          },
          {
            "id": "about.bannerImage",
            "fieldPath": "sections.about.bannerImage",
            "kind": "media",
            "label": "About banner"
          },
          {
            "id": "brand.name",
            "fieldPath": "brand.name",
            "kind": "string",
            "label": "Brand name",
            "editorSurface": "none"
          },
          {
            "id": "brand.tagline",
            "fieldPath": "brand.tagline",
            "kind": "string",
            "label": "Brand tagline",
            "editorSurface": "none"
          }
        ]
      }
    }
  }
}
