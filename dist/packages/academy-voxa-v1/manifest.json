{
  "templateId": "academy-voxa-v1",
  "name": "Voxa",
  "displayName": "Voxa Academia",
  "description": "Template e-commerce para academias de oratoria y comunicación estratégica que venden programas y libros. Identidad visual fija: tipografía Fraunces/Source Sans 3, navy profundo + acento teal, hero full-bleed con halo teal y wordmark dominante, programas destacados, metodología en pasos, resultados y franja editorial.",
  "category": "ecommerce-courses",
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "locale": "es-ES",
  "preview": {
    "path": "/t/voxa",
    "thumbnail": "https://images.unsplash.com/photo-1531058020387-3be344556be6?w=1200&q=80"
  },
  "runtime": {
    "framework": "nextjs-app-router",
    "mountPath": "/t/voxa",
    "codeEntry": "src/index.ts",
    "packageDir": "templates/academy-voxa-v1",
    "renderer": "VoxaApp"
  },
  "routes": [
    {
      "path": "/",
      "page": "home",
      "sections": [
        "hero",
        "programs",
        "method",
        "outcomes",
        "books"
      ]
    },
    {
      "path": "/programas",
      "page": "shop",
      "sections": [
        "shop"
      ],
      "queryParams": {
        "categoria": "Optional category slug (catalog.categories[].slug). Navbar shopFilter.categorySlug resolves here.",
        "coleccion": "Optional collection slug (catalog.collections[].slug). Navbar shopFilter.collectionSlug resolves here."
      }
    },
    {
      "path": "/programas/[slug]",
      "page": "product",
      "sections": [
        "product",
        "related"
      ]
    },
    {
      "path": "/academia",
      "page": "about",
      "sections": [
        "about"
      ]
    }
  ],
  "sections": [
    "hero",
    "programs",
    "method",
    "outcomes",
    "books",
    "shop",
    "about",
    "footer"
  ],
  "capabilities": {
    "catalog": true,
    "collections": true,
    "cart": true,
    "newsletter": false,
    "appointment": false,
    "account": true,
    "themeColors": true,
    "fontsConfigurable": false
  },
  "commerce": {
    "mode": "preview-only",
    "contractVersion": null,
    "views": {
      "productListing": true,
      "productDetail": true,
      "cartPage": true,
      "cartDrawer": true,
      "checkoutLayout": true,
      "checkoutPage": true,
      "orderConfirmation": true,
      "accountLogin": true,
      "accountRegister": true,
      "accountDashboard": true
    },
    "capabilities": {
      "productListing": "required",
      "search": "supported",
      "categoryFilter": "supported",
      "collectionFilter": "supported",
      "brandFilter": "supported",
      "sorting": "required",
      "cursorPagination": "required",
      "productDetail": "required",
      "variantSelector": "required-when-applicable",
      "gallery": "supported",
      "stockIndicator": "supported",
      "relatedProducts": "supported",
      "cartDrawer": "supported",
      "cartPage": "supported",
      "checkoutLayout": "supported",
      "checkoutMapPicker": "unsupported",
      "paymentVoucherUpload": "unsupported",
      "taxCalculation": "host-controlled",
      "shippingCalculation": "host-controlled",
      "inventoryValidation": "host-controlled",
      "placeOrder": "host-controlled",
      "salesModeSwitch": "unsupported"
    }
  },
  "mediaSlots": [
    {
      "id": "hero.image",
      "section": "hero",
      "aspect": "full-bleed",
      "recommendedWidth": 2400
    },
    {
      "id": "outcomes.image",
      "section": "outcomes",
      "aspect": "4/5",
      "recommendedWidth": 1600
    },
    {
      "id": "about.bannerImage",
      "section": "about",
      "aspect": "wide",
      "recommendedWidth": 2400
    },
    {
      "id": "products[].image",
      "section": "catalog",
      "aspect": "4/3",
      "recommendedWidth": 1200
    },
    {
      "id": "products[].hoverImage",
      "section": "catalog",
      "aspect": "4/3",
      "optional": true
    },
    {
      "id": "collections[].image",
      "section": "catalog",
      "aspect": "4/3",
      "recommendedWidth": 1600
    }
  ],
  "constraints": {
    "catalogRefs": [
      "sections.programs.productIds",
      "sections.books.productIds"
    ],
    "catalogBindings": [
      {
        "path": "sections.programs.productIds",
        "kind": "product",
        "sectionId": "programs",
        "label": {
          "es": "Programas destacados",
          "en": "Featured programs"
        },
        "maxItems": 6
      },
      {
        "path": "sections.books.productIds",
        "kind": "product",
        "sectionId": "books",
        "label": {
          "es": "Libros",
          "en": "Books"
        },
        "maxItems": 6
      }
    ],
    "commerceFeaturedProductsPath": "sections.programs.productIds",
    "featuredProductPath": "sections.programs.productIds",
    "featuredCount": 3,
    "featuredBooksPath": "sections.books.productIds",
    "methodStepsRange": [
      3,
      4
    ]
  },
  "export": {
    "files": [
      "manifest.json",
      "builder.manifest.json",
      "schema.json",
      "commerce.schema.json",
      "defaults.json",
      "package.json",
      "src/",
      "fixtures/",
      "README.md",
      "PROOF.md",
      "BUILD_INFO.json",
      "IMMUTABLE"
    ],
    "command": "npm run template:export -- academy-voxa-v1",
    "output": "dist/packages/academy-voxa-v1",
    "consumer": "IA Builder v2 — solo genera/edita Content Payload validado contra schema.json; nunca modifica el código del template."
  }
}
