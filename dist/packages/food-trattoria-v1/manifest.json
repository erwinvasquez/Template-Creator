{
  "templateId": "food-trattoria-v1",
  "name": "Trattoria",
  "displayName": "Trattoria Nonna",
  "description": "Template e-commerce de restaurante italiano: Playfair Display SC + Karla, terracota y dorado, pasta fresca, cocina abierta, carta de vinos y despensa. Dual sales mode (listo / a pedido).",
  "category": "ecommerce-food",
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "locale": "es-ES",
  "preview": {
    "path": "/t/trattoria",
    "thumbnail": "https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1200&q=80"
  },
  "runtime": {
    "framework": "nextjs-app-router",
    "mountPath": "/t/trattoria",
    "codeEntry": "src/index.ts",
    "packageDir": "templates/food-trattoria-v1",
    "renderer": "TrattoriaApp"
  },
  "routes": [
    {
      "path": "/",
      "page": "home",
      "sections": [
        "hero",
        "courses",
        "kitchen",
        "signatures",
        "sommelier",
        "pantry",
        "footer"
      ]
    },
    {
      "path": "/menu",
      "page": "shop",
      "sections": [
        "shop"
      ],
      "queryParams": {
        "categoria": "Optional category slug (catalog.categories[].slug). Navbar shopFilter.categorySlug resolves here.",
        "coleccion": "Optional collection slug (catalog.collections[].slug). Navbar shopFilter.collectionSlug resolves here."
      }
    },
    {
      "path": "/menu/[slug]",
      "page": "product",
      "sections": [
        "product",
        "related"
      ]
    },
    {
      "path": "/nosotros",
      "page": "about",
      "sections": [
        "about"
      ]
    }
  ],
  "sections": [
    "hero",
    "courses",
    "kitchen",
    "signatures",
    "sommelier",
    "pantry",
    "shop",
    "about",
    "footer"
  ],
  "capabilities": {
    "catalog": true,
    "collections": true,
    "cart": true,
    "newsletter": false,
    "themeColors": true,
    "fontsConfigurable": false,
    "productDetailPresentation": {
      "supportedFields": [
        "description",
        "collection",
        "category",
        "variants",
        "relatedProducts"
      ]
    }
  },
  "commerce": {
    "mode": "preview-only",
    "contractVersion": null,
    "views": {
      "productListing": true,
      "productDetail": true,
      "cartPage": true,
      "cartDrawer": true,
      "checkoutLayout": true,
      "checkoutPage": false,
      "orderConfirmation": true,
      "orderTracking": true,
      "accountLogin": true,
      "accountRegister": true,
      "accountDashboard": true
    },
    "capabilities": {
      "productListing": "required",
      "search": "supported",
      "categoryFilter": "supported",
      "collectionFilter": "supported",
      "brandFilter": "supported",
      "sorting": "required",
      "cursorPagination": "required",
      "productDetail": "required",
      "variantSelector": "required-when-applicable",
      "gallery": "supported",
      "stockIndicator": "supported",
      "relatedProducts": "supported",
      "cartDrawer": "supported",
      "cartPage": "supported",
      "checkoutLayout": "supported",
      "checkoutMapPicker": "unsupported",
      "paymentVoucherUpload": "unsupported",
      "taxCalculation": "host-controlled",
      "shippingCalculation": "host-controlled",
      "inventoryValidation": "host-controlled",
      "placeOrder": "host-controlled",
      "salesModeSwitch": "supported"
    }
  },
  "mediaSlots": [
    {
      "id": "hero.image",
      "section": "hero",
      "aspect": "full-bleed",
      "recommendedWidth": 2400
    },
    {
      "id": "hero.carousel[]",
      "section": "hero",
      "aspect": "full-bleed",
      "count": 6,
      "recommendedWidth": 2400
    },
    {
      "id": "courses[].image",
      "section": "courses",
      "aspect": "3/4",
      "count": 4,
      "recommendedWidth": 1600
    },
    {
      "id": "about.bannerImage",
      "section": "about",
      "aspect": "wide",
      "recommendedWidth": 2400
    },
    {
      "id": "products[].image",
      "section": "catalog",
      "aspect": "3/4",
      "recommendedWidth": 1200
    },
    {
      "id": "products[].hoverImage",
      "section": "catalog",
      "aspect": "3/4",
      "optional": true
    }
  ],
  "constraints": {
    "catalogRefs": [
      "sections.signatures.productIds",
      "sections.pantry.productIds",
      "sections.courses.collectionIds"
    ],
    "catalogBindings": [
      {
        "path": "sections.signatures.productIds",
        "kind": "product",
        "sectionId": "signatures",
        "label": {
          "es": "Platos firma",
          "en": "Signature dishes"
        },
        "maxItems": 8
      },
      {
        "path": "sections.pantry.productIds",
        "kind": "product",
        "sectionId": "pantry",
        "label": {
          "es": "Despensa",
          "en": "Pantry"
        },
        "maxItems": 12
      },
      {
        "path": "sections.courses.collectionIds",
        "kind": "collection",
        "sectionId": "courses",
        "label": {
          "es": "Cartas de mesa",
          "en": "Table menus"
        },
        "maxItems": 4
      }
    ],
    "commerceFeaturedProductsPath": "sections.signatures.productIds",
    "commerceFeaturedCollectionsPath": "sections.courses.collectionIds"
  },
  "export": {
    "files": [
      "manifest.json",
      "builder.manifest.json",
      "schema.json",
      "defaults.json",
      "package.json",
      "src/",
      "fixtures/",
      "README.md",
      "PROOF.md",
      "BUILD_INFO.json",
      "IMMUTABLE"
    ],
    "command": "npm run template:export -- food-trattoria-v1",
    "output": "dist/packages/food-trattoria-v1",
    "consumer": "IA Builder v2 — solo genera/edita Content Payload validado contra schema.json; nunca modifica el código del template."
  }
}
