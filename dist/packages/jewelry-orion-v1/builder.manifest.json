            "label": "Craft eyebrow"
          },
          {
            "id": "craft.title",
            "fieldPath": "sections.craft.title",
            "kind": "string",
            "label": "Craft title"
          },
          {
            "id": "craft.body",
            "fieldPath": "sections.craft.body",
            "kind": "text",
            "label": "Craft body"
          },
          {
            "id": "craft.image",
            "fieldPath": "sections.craft.image",
            "kind": "media",
            "label": "Craft image"
          },
          {
            "id": "materials.eyebrow",
            "fieldPath": "sections.materials.eyebrow",
            "kind": "string",
            "label": "Materials eyebrow"
          },
          {
            "id": "materials.title",
            "fieldPath": "sections.materials.title",
            "kind": "string",
            "label": "Materials title"
          },
          {
            "id": "appointment.eyebrow",
            "fieldPath": "sections.appointment.eyebrow",
            "kind": "string",
            "label": "Appointment eyebrow"
          },
          {
            "id": "appointment.title",
            "fieldPath": "sections.appointment.title",
            "kind": "string",
