{
  "schemaVersion": "1.0.0",
  "templateId": "jewelry-orion-v1",
  "descriptor": {
    "templateId": "orion",
    "latestVersion": "1.3.0",
    "status": "published",
    "websiteType": "ecommerce",
    "industryTags": [
      "jewelry",
      "luxury",
      "ecommerce"
    ],
    "displayName": {
      "es": "Orion Alta Joyería",
      "en": "Orion Fine Jewelry"
    },
    "description": {
      "es": "E-commerce de alta joyería: estética platino/champán, colección y atelier.",
      "en": "Fine jewelry ecommerce with platinum/champagne aesthetic, collection, and atelier."
    }
  },
  "manifest": {
    "pages": [
      {
        "id": "home",
        "path": "/",
        "page": "home",
        "sections": [
          {
            "id": "hero",
            "contentSlotIds": [
              "hero.headline",
              "hero.subheadline",
              "hero.image",
              "hero.ctaPrimary"
            ]
          },
          {
            "id": "signatures",
            "contentSlotIds": [
              "signatures.eyebrow",
              "signatures.title"
            ]
          },
          {
            "id": "craft",
            "contentSlotIds": [
              "craft.eyebrow",
              "craft.title",
              "craft.body",
              "craft.image"
            ]
          },
          {
            "id": "materials",
            "contentSlotIds": [
              "materials.eyebrow",
              "materials.title"
            ]
          },
          {
            "id": "appointment",
            "contentSlotIds": [
              "appointment.eyebrow",
              "appointment.title",
              "appointment.body",
              "appointment.cta"
            ]
          }
        ]
      },
      {
        "id": "shop",
        "path": "/coleccion",
        "page": "shop",
        "sections": [
          {
            "id": "shop",
            "contentSlotIds": [
              "shop.eyebrow",
              "shop.title",
              "shop.description"
            ]
          }
        ]
      },
      {
        "id": "product",
        "path": "/coleccion/[slug]",
        "page": "product",
        "sections": [
          {
            "id": "product",
            "contentSlotIds": []
          }
        ]
      },
      {
        "id": "about",
        "path": "/atelier",
        "page": "about",
        "sections": [
          {
            "id": "atelier",
            "contentSlotIds": [
              "atelier.intro.eyebrow",
              "atelier.intro.title",
              "atelier.intro.body",
              "atelier.bannerImage"
            ]
          }
        ]
      }
    ],
    "navigation": {
      "primaryFromPayload": "navigation.primary"
    },
    "themeDefaults": {
      "colors": {
        "primary": "#141210",
        "secondary": "#5C564F",
        "cta": "#B8956A",
        "ctaHover": "#9A7A55",
        "background": "#FAFAF8",
        "surface": "#F0EDE8",
        "text": "#121212",
        "muted": "#6B6560",
        "border": "#DDD6CC",
        "ink": "#0E0E10"
      }
    },
    "themeEditable": {
      "primary": true,
      "secondary": true,
      "background": true,
      "fonts": false
    },
    "capabilities": {
      "contentSupport": {
        "slotDefinitions": [
          {
            "id": "hero.headline",
            "fieldPath": "sections.hero.headline",
            "kind": "string",
            "label": "Hero headline"
          },
          {
            "id": "hero.subheadline",
            "fieldPath": "sections.hero.subheadline",
            "kind": "string",
            "label": "Hero subheadline"
          },
          {
            "id": "hero.image",
            "fieldPath": "sections.hero.image",
            "kind": "media",
            "label": "Hero image"
          },
          {
            "id": "hero.ctaPrimary",
            "fieldPath": "sections.hero.ctaPrimary",
            "kind": "link",
            "label": "Hero primary CTA"
          },
          {
            "id": "signatures.eyebrow",
            "fieldPath": "sections.signatures.eyebrow",
            "kind": "string",
            "label": "Signatures eyebrow"
          },
          {
