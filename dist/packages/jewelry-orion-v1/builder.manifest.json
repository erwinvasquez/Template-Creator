          {
            "id": "appointment.body",
            "fieldPath": "sections.appointment.body",
            "kind": "text",
            "label": "Appointment body"
          },
          {
            "id": "appointment.cta",
            "fieldPath": "sections.appointment.cta",
            "kind": "link",
            "label": "Appointment CTA"
          },
          {
            "id": "shop.eyebrow",
            "fieldPath": "sections.shop.eyebrow",
            "kind": "string",
            "label": "Shop eyebrow"
          },
          {
            "id": "shop.title",
            "fieldPath": "sections.shop.title",
            "kind": "string",
            "label": "Shop title"
          },
          {
            "id": "shop.description",
            "fieldPath": "sections.shop.description",
            "kind": "text",
            "label": "Shop description"
          },
          {
            "id": "atelier.intro.eyebrow",
            "fieldPath": "sections.atelier.intro.eyebrow",
            "kind": "string",
            "label": "Atelier eyebrow"
          },
          {
            "id": "atelier.intro.title",
            "fieldPath": "sections.atelier.intro.title",
            "kind": "string",
            "label": "Atelier title"
          },
          {
            "id": "atelier.intro.body",
            "fieldPath": "sections.atelier.intro.body",
            "kind": "text",
            "label": "Atelier body"
          },
          {
            "id": "atelier.bannerImage",
            "fieldPath": "sections.atelier.bannerImage",
            "kind": "media",
            "label": "Atelier banner"
          },
          {
            "id": "brand.name",
            "fieldPath": "brand.name",
            "kind": "string",
            "label": "Brand name",
            "editorSurface": "none"
          },
          {
            "id": "brand.tagline",
            "fieldPath": "brand.tagline",
