{
  "templateId": "jewelry-orion-v1",
  "name": "Orion",
  "displayName": "Orion Alta Joyería",
  "description": "Template e-commerce de alta joyería. Identidad visual fija: tipografía Bodoni Moda/Jost, negro platino + acento champán, header sticky con marca a la izquierda, hero full-bleed con wordmark inferior, piezas insignia, atelier 50/50, materiales y banda de cita privada.",
  "category": "ecommerce-jewelry",
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "locale": "es-ES",
  "preview": {
    "path": "/t/orion",
    "thumbnail": "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?w=1200&q=80"
  },
  "runtime": {
    "framework": "nextjs-app-router",
    "mountPath": "/t/orion",
    "codeEntry": "src/index.ts",
    "packageDir": "templates/jewelry-orion-v1",
    "renderer": "JewelryApp"
  },
  "routes": [
    { "path": "/", "page": "home", "sections": ["hero", "signatures", "craft", "materials", "appointment"] },
    { "path": "/coleccion", "page": "shop", "sections": ["shop"] },
    { "path": "/coleccion/[slug]", "page": "product", "sections": ["product", "related"] },
    { "path": "/atelier", "page": "atelier", "sections": ["atelier"] }
  ],
  "sections": [
    "hero",
    "signatures",
    "craft",
    "materials",
    "appointment",
    "shop",
    "atelier",
    "footer"
  ],
  "capabilities": {
    "catalog": true,
    "collections": true,
    "cart": true,
    "newsletter": false,
    "appointment": true,
    "themeColors": true,
    "fontsConfigurable": false
  },
  "mediaSlots": [
    { "id": "hero.image", "section": "hero", "aspect": "full-bleed", "recommendedWidth": 2400 },
    { "id": "craft.image", "section": "craft", "aspect": "4/5", "recommendedWidth": 1600 },
    { "id": "materials.items[].image", "section": "materials", "aspect": "1/1", "count": 4, "recommendedWidth": 1200 },
    { "id": "atelier.bannerImage", "section": "atelier", "aspect": "wide", "recommendedWidth": 2400 },
    { "id": "products[].image", "section": "catalog", "aspect": "1/1", "recommendedWidth": 1200 },
    { "id": "products[].hoverImage", "section": "catalog", "aspect": "1/1", "optional": true }
  ],
  "constraints": {
    "featuredProductPath": "sections.signatures.productIds",
    "featuredCount": 3
  },
  "export": {
    "files": [
      "manifest.json",
      "schema.json",
      "defaults.json",
      "package.json",
      "src/",
      "fixtures/",
      "README.md",
      "PROOF.md",
      "BUILD_INFO.json",
      "IMMUTABLE"
    ],
    "command": "npm run template:export -- jewelry-orion-v1",
    "output": "dist/packages/jewelry-orion-v1",
    "consumer": "IA Builder v2 — solo genera/edita Content Payload validado contra schema.json; nunca modifica el código del template."
  }
}
