{
  "templateId": "jewelry-orion-v1",
  "name": "Orion",
  "displayName": "Orion Alta Joyería",
  "description": "Template e-commerce de alta joyería. Identidad visual fija: tipografía Bodoni Moda/Jost, negro platino + acento champán, header sticky con marca a la izquierda, hero full-bleed con wordmark inferior, piezas insignia, atelier 50/50, materiales y banda de cita privada.",
  "category": "ecommerce-jewelry",
  "version": "1.3.0",
  "schemaVersion": "1.0.0",
  "locale": "es-ES",
  "preview": {
    "path": "/t/orion",
    "thumbnail": "https://images.unsplash.com/photo-1617038260897-41a1f14a8ca0?w=1200&q=80"
  },
  "runtime": {
    "framework": "nextjs-app-router",
    "mountPath": "/t/orion",
    "codeEntry": "src/index.ts",
    "packageDir": "templates/jewelry-orion-v1",
    "renderer": "JewelryApp"
  },
  "routes": [
    {
      "path": "/",
      "page": "home",
      "sections": [
        "hero",
        "signatures",
        "craft",
        "materials",
        "appointment",
        "footer"
      ]
    },
    {
      "path": "/coleccion",
      "page": "shop",
      "sections": [
        "shop"
      ],
      "queryParams": {
        "categoria": "Optional category slug (catalog.categories[].slug). Navbar shopFilter.categorySlug resolves here.",
        "coleccion": "Optional collection slug (catalog.collections[].slug). Navbar shopFilter.collectionSlug resolves here."
      }
    },
    {
      "path": "/coleccion/[slug]",
      "page": "product",
      "sections": [
        "product",
        "related"
      ]
    },
    {
      "path": "/atelier",
      "page": "about",
      "sections": [
        "atelier"
      ]
    }
  ],
  "sections": [
    "hero",
    "signatures",
    "craft",
    "materials",
    "appointment",
    "shop",
    "atelier",
    "footer"
  ],
  "capabilities": {
    "catalog": true,
    "collections": true,
    "cart": true,
    "newsletter": false,
    "appointment": true,
    "account": true,
    "themeColors": true,
    "fontsConfigurable": false
  },
  "commerce": {
    "mode": "preview-only",
    "contractVersion": null,
    "views": {
      "productListing": true,
      "productDetail": true,
      "cartPage": true,
      "cartDrawer": true,
      "checkoutLayout": true,
      "checkoutPage": false,
      "orderConfirmation": true,
      "orderTracking": true,
      "accountLogin": true,
      "accountRegister": true,
      "accountDashboard": true
    },
    "capabilities": {
      "productListing": "required",
      "search": "supported",
      "categoryFilter": "supported",
      "collectionFilter": "supported",
      "brandFilter": "supported",
      "sorting": "required",
      "cursorPagination": "required",
      "productDetail": "required",
      "variantSelector": "required-when-applicable",
      "gallery": "supported",
      "stockIndicator": "supported",
      "relatedProducts": "supported",
      "cartDrawer": "supported",
      "cartPage": "supported",
      "checkoutLayout": "supported",
      "checkoutMapPicker": "unsupported",
      "paymentVoucherUpload": "unsupported",
      "taxCalculation": "host-controlled",
      "shippingCalculation": "host-controlled",
      "inventoryValidation": "host-controlled",
      "placeOrder": "host-controlled",
      "salesModeSwitch": "unsupported"
    }
  },
  "mediaSlots": [
    {
      "id": "hero.image",
      "section": "hero",
      "aspect": "full-bleed",
      "recommendedWidth": 2400
    },
    {
      "id": "hero.carousel[]",
      "section": "hero",
      "aspect": "full-bleed",
      "count": 6,
      "recommendedWidth": 2400
    },
    {
      "id": "craft.image",
      "section": "craft",
      "aspect": "4/5",
      "recommendedWidth": 1600
    },
    {
      "id": "materials.items[].image",
      "section": "materials",
      "aspect": "1/1",
      "count": 4,
      "recommendedWidth": 1200
    },
    {
      "id": "atelier.bannerImage",
      "section": "atelier",
      "aspect": "wide",
      "recommendedWidth": 2400
    },
    {
      "id": "products[].image",
      "section": "catalog",
      "aspect": "1/1",
      "recommendedWidth": 1200
    },
    {
      "id": "products[].hoverImage",
      "section": "catalog",
      "aspect": "1/1",
      "optional": true
    }
  ],
  "constraints": {
    "catalogRefs": [
      "sections.signatures.productIds"
    ],
    "catalogBindings": [
      {
        "path": "sections.signatures.productIds",
        "kind": "product",
        "sectionId": "signatures",
        "label": {
          "es": "Piezas insignia",
          "en": "Signature pieces"
        },
        "maxItems": 6
      }
    ],
    "commerceFeaturedProductsPath": "sections.signatures.productIds",
    "featuredProductPath": "sections.signatures.productIds",
    "featuredCount": 3
  },
  "export": {
    "files": [
      "manifest.json",
      "builder.manifest.json",
      "schema.json",
      "commerce.schema.json",
      "defaults.json",
      "package.json",
      "src/",
      "fixtures/",
      "README.md",
      "PROOF.md",
      "BUILD_INFO.json",
      "IMMUTABLE"
    ],
    "command": "npm run template:export -- jewelry-orion-v1",
    "output": "dist/packages/jewelry-orion-v1",
    "consumer": "IA Builder v2 — solo genera/edita Content Payload validado contra schema.json; nunca modifica el código del template."
  }
}
