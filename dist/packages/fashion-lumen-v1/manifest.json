{
  "templateId": "fashion-lumen-v1",
  "name": "Lumen",
  "displayName": "Lumen",
  "description": "Template e-commerce de moda femenina editorial minimal: Playfair Display + Inter, carbón + blush, quiet luxury daytime, guardarropa por colección, nuevas llegadas, nota de tejidos, banda editorial y tienda con dual sales mode.",
  "category": "ecommerce-fashion",
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "locale": "es-ES",
  "preview": {
    "path": "/t/lumen",
    "thumbnail": "https://images.unsplash.com/photo-1490481651871-ab68de25d43d?w=1200&q=80"
  },
  "runtime": {
    "framework": "nextjs-app-router",
    "mountPath": "/t/lumen",
    "codeEntry": "src/index.ts",
    "packageDir": "templates/fashion-lumen-v1",
    "renderer": "LumenApp"
  },
  "routes": [
    {
      "path": "/",
      "page": "home",
      "sections": [
        "hero",
        "wardrobe",
        "arrivals",
        "fabricNote",
        "editorial",
        "footer"
      ]
    },
    {
      "path": "/tienda",
      "page": "shop",
      "sections": [
        "shop"
      ],
      "queryParams": {
        "categoria": "Optional category slug (catalog.categories[].slug). Navbar shopFilter.categorySlug resolves here.",
        "coleccion": "Optional collection slug (catalog.collections[].slug). Navbar shopFilter.collectionSlug resolves here."
      }
    },
    {
      "path": "/tienda/[slug]",
      "page": "product",
      "sections": [
        "product",
        "related"
      ]
    },
    {
      "path": "/nosotros",
      "page": "about",
      "sections": [
        "about"
      ]
    }
  ],
  "sections": [
    "hero",
    "wardrobe",
    "arrivals",
    "fabricNote",
    "editorial",
    "shop",
    "about",
    "footer"
  ],
  "capabilities": {
    "catalog": true,
    "collections": true,
    "cart": true,
    "newsletter": false,
    "themeColors": true,
    "fontsConfigurable": false
  },
  "commerce": {
    "mode": "preview-only",
    "contractVersion": null,
    "views": {
      "productListing": true,
      "productDetail": true,
      "cartPage": true,
      "cartDrawer": true,
      "checkoutLayout": true,
      "checkoutPage": false,
      "orderConfirmation": true,
      "orderTracking": true,
      "accountLogin": true,
      "accountRegister": true,
      "accountDashboard": true
    },
    "capabilities": {
      "productListing": "required",
      "search": "supported",
      "categoryFilter": "supported",
      "collectionFilter": "supported",
      "brandFilter": "supported",
      "sorting": "required",
      "cursorPagination": "required",
      "productDetail": "required",
      "variantSelector": "required-when-applicable",
      "gallery": "supported",
      "stockIndicator": "supported",
      "relatedProducts": "supported",
      "cartDrawer": "supported",
      "cartPage": "supported",
      "checkoutLayout": "supported",
      "checkoutMapPicker": "unsupported",
      "paymentVoucherUpload": "unsupported",
      "taxCalculation": "host-controlled",
      "shippingCalculation": "host-controlled",
      "inventoryValidation": "host-controlled",
      "placeOrder": "host-controlled",
      "salesModeSwitch": "supported"
    }
  },
  "mediaSlots": [
    {
      "id": "hero.image",
      "section": "hero",
      "aspect": "full-bleed",
      "recommendedWidth": 2400
    },
    {
      "id": "hero.carousel[]",
      "section": "hero",
      "aspect": "full-bleed",
      "count": 6,
      "recommendedWidth": 2400
    },
    {
      "id": "wardrobe[].image",
      "section": "wardrobe",
      "aspect": "4/5",
      "count": 3,
      "recommendedWidth": 1600
    },
    {
      "id": "fabricNote.image",
      "section": "fabricNote",
      "aspect": "full-bleed",
      "recommendedWidth": 2400
    },
    {
      "id": "about.bannerImage",
      "section": "about",
      "aspect": "wide",
      "recommendedWidth": 2400
    },
    {
      "id": "products[].image",
      "section": "catalog",
      "aspect": "3/4",
      "recommendedWidth": 1200
    },
    {
      "id": "products[].hoverImage",
      "section": "catalog",
      "aspect": "3/4",
      "optional": true
    }
  ],
  "constraints": {
    "catalogRefs": [
      "sections.arrivals.productIds",
      "sections.wardrobe.collectionIds"
    ],
    "catalogBindings": [
      {
        "path": "sections.arrivals.productIds",
        "kind": "product",
        "sectionId": "arrivals",
        "label": {
          "es": "Nuevas llegadas",
          "en": "New arrivals"
        },
        "maxItems": 8
      },
      {
        "path": "sections.wardrobe.collectionIds",
        "kind": "collection",
        "sectionId": "wardrobe",
        "label": {
          "es": "Colecciones",
          "en": "Collections"
        },
        "maxItems": 3
      }
    ],
    "commerceFeaturedProductsPath": "sections.arrivals.productIds",
    "commerceFeaturedCollectionsPath": "sections.wardrobe.collectionIds",
    "featuredProductPath": "sections.arrivals.productIds",
    "collectionIdsPath": "sections.wardrobe.collectionIds",
    "wardrobeCount": 3
  },
  "export": {
    "files": [
      "manifest.json",
      "builder.manifest.json",
      "schema.json",
      "defaults.json",
      "package.json",
      "src/",
      "fixtures/",
      "README.md",
      "PROOF.md",
      "BUILD_INFO.json",
      "IMMUTABLE"
    ],
    "command": "npm run template:export -- fashion-lumen-v1",
    "output": "dist/packages/fashion-lumen-v1",
    "consumer": "IA Builder v2 — solo genera/edita Content Payload validado contra schema.json; nunca modifica el código del template."
  }
}
