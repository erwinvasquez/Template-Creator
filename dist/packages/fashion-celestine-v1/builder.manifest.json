{
  "schemaVersion": "1.0.0",
  "templateId": "fashion-celestine-v1",
  "descriptor": {
    "templateId": "celestine",
    "latestVersion": "1.0.0",
    "status": "published",
    "websiteType": "ecommerce",
    "industryTags": [
      "fashion",
      "luxury",
      "apparel",
      "artisan"
    ],
    "displayName": {
      "es": "Celestine Atelier",
      "en": "Celestine Atelier"
    },
    "description": {
      "es": "E-commerce de vestidos de ocasión: fiesta, novias, quinceañeras y comunión, con accesorios artesanales.",
      "en": "Occasion-wear ecommerce: evening, bridal, quinceañera and communion dresses, plus artisan accessories."
    }
  },
  "manifest": {
    "pages": [
      {
        "id": "home",
        "path": "/",
        "page": "home",
        "sections": [
          {
            "id": "hero",
            "contentSlotIds": [
              "hero.headline",
              "hero.subheadline",
              "hero.image",
              "hero.ctaPrimary"
            ]
          },
          {
            "id": "occasions",
            "contentSlotIds": [
              "occasions.eyebrow",
              "occasions.title"
            ]
          },
          {
            "id": "craft",
            "contentSlotIds": [
              "craft.eyebrow",
              "craft.title",
              "craft.body"
            ]
          },
          {
            "id": "signature",
            "contentSlotIds": [
              "signature.eyebrow",
              "signature.title"
            ]
          },
          {
            "id": "note",
            "contentSlotIds": [
              "note.eyebrow",
              "note.title",
              "note.body"
            ]
          },
          {
            "id": "accessories",
            "contentSlotIds": [
              "accessories.eyebrow",
              "accessories.title",
              "accessories.body"
            ]
          }
        ]
      },
      {
        "id": "shop",
        "path": "/vestidos",
        "page": "shop",
        "sections": [
          {
            "id": "shop",
            "contentSlotIds": [
              "shop.eyebrow",
              "shop.title",
              "shop.description"
            ]
          }
        ]
      },
      {
        "id": "product",
        "path": "/vestidos/[slug]",
        "page": "product",
        "sections": [
          {
            "id": "product",
            "contentSlotIds": []
          }
        ]
      },
      {
        "id": "about",
        "path": "/casa",
        "page": "about",
        "sections": [
          {
            "id": "about",
            "contentSlotIds": [
              "about.intro.eyebrow",
              "about.intro.title",
              "about.intro.body",
              "about.bannerImage"
            ]
          }
        ]
      }
    ],
    "navigation": {
      "primaryFromPayload": "navigation.primary"
    },
    "themeDefaults": {
      "colors": {
        "primary": "#1A1216",
        "secondary": "#6B4E56",
        "cta": "#9C4F5F",
        "ctaHover": "#7E3E4C",
        "background": "#F8F4F5",
        "surface": "#EFE6E8",
        "text": "#1A1216",
        "muted": "#746266",
        "border": "#E0D4D7"
      }
    },
    "themeEditable": {
      "primary": true,
      "secondary": true,
      "background": true,
      "fonts": false
    },
