{
  "schemaVersion": "1.0.0",
  "templateId": "academy-voxa-v1",
  "descriptor": {
    "templateId": "voxa",
    "latestVersion": "1.0.0",
    "status": "published",
    "websiteType": "ecommerce",
    "industryTags": ["courses", "coaching", "education", "books"],
    "displayName": {
      "es": "Voxa Academia",
      "en": "Voxa Academy"
    },
    "description": {
      "es": "Academia de oratoria y comunicación estratégica: venta de programas y libros, estética navy/teal, metodología por pasos y editorial propia.",
      "en": "Public speaking and strategic communication academy: sells programs and books, navy/teal aesthetic, step-based methodology, and its own publishing strip."
    }
  },
  "manifest": {
    "pages": [
      {
        "id": "home",
        "path": "/",
        "page": "home",
        "sections": [
          {
            "id": "hero",
            "contentSlotIds": [
              "hero.headline",
              "hero.subheadline",
              "hero.image",
              "hero.ctaPrimary",
              "hero.ctaSecondary"
            ]
          },
          {
            "id": "programs",
            "contentSlotIds": ["programs.eyebrow", "programs.title"]
          },
          {
            "id": "method",
            "contentSlotIds": ["method.eyebrow", "method.title", "method.body"]
          },
          {
            "id": "outcomes",
            "contentSlotIds": [
              "outcomes.eyebrow",
              "outcomes.title",
              "outcomes.body",
              "outcomes.bullets",
              "outcomes.image"
            ]
          },
          {
            "id": "books",
            "contentSlotIds": ["books.eyebrow", "books.title", "books.cta"]
          }
        ]
      },
      {
        "id": "shop",
        "path": "/programas",
        "page": "shop",
        "sections": [
          {
            "id": "shop",
            "contentSlotIds": ["shop.eyebrow", "shop.title", "shop.description"]
          }
        ]
      },
      {
        "id": "product",
        "path": "/programas/[slug]",
        "page": "product",
        "sections": [{ "id": "product", "contentSlotIds": [] }]
      },
      {
        "id": "about",
        "path": "/academia",
        "page": "about",
        "sections": [
          {
            "id": "about",
            "contentSlotIds": [
              "about.intro.eyebrow",
              "about.intro.title",
              "about.intro.body",
              "about.bannerImage",
              "about.faculty.eyebrow",
              "about.faculty.title"
            ]
          }
        ]
      }
    ],
    "navigation": {
      "primaryFromPayload": "navigation.primary"
    },
    "themeDefaults": {
      "colors": {
        "primary": "#14213D",
        "secondary": "#3A506B",
        "cta": "#0D9488",
        "ctaHover": "#0F766E",
        "background": "#F4F6F8",
        "surface": "#E8EEF2",
        "text": "#12141A",
        "muted": "#5C6570",
        "border": "#D5DDE5",
        "ink": "#0B1220"
      }
    },
    "capabilities": {
      "contentSupport": {
        "slotDefinitions": [
          {
            "id": "hero.headline",
            "fieldPath": "sections.hero.headline",
            "kind": "string",
            "label": "Hero headline"
          },
          {
            "id": "hero.subheadline",
            "fieldPath": "sections.hero.subheadline",
            "kind": "text",
            "label": "Hero support line"
          },
          {
            "id": "hero.image",
            "fieldPath": "sections.hero.image",
            "kind": "media",
            "label": "Hero image (full-bleed)"
          },
          {
            "id": "hero.ctaPrimary",
            "fieldPath": "sections.hero.ctaPrimary",
            "kind": "link",
            "label": "Hero primary CTA"
          },
          {
            "id": "hero.ctaSecondary",
            "fieldPath": "sections.hero.ctaSecondary",
            "kind": "link",
            "label": "Hero secondary CTA"
          },
