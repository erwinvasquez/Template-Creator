{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://shopenlinea.local/schemas/commerce-manifest.json",
  "title": "CommerceManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["mode", "contractVersion", "views", "capabilities"],
  "properties": {
    "mode": {
      "type": "string",
      "enum": ["preview-only", "runtime"]
    },
    "contractVersion": {
      "type": ["string", "null"]
    },
    "views": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "productListing",
        "productDetail",
        "cartPage",
        "cartDrawer",
        "checkoutLayout",
        "orderConfirmation"
      ],
      "properties": {
        "productListing": { "type": "boolean" },
        "productDetail": { "type": "boolean" },
        "cartPage": { "type": "boolean" },
        "cartDrawer": { "type": "boolean" },
        "checkoutLayout": { "type": "boolean" },
        "checkoutPage": { "type": "boolean" },
        "orderConfirmation": { "type": "boolean" },
        "accountLogin": { "type": "boolean" },
        "accountRegister": { "type": "boolean" },
        "accountDashboard": { "type": "boolean" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/CapabilityLevel"
      },
      "properties": {
        "productListing": { "$ref": "#/definitions/CapabilityLevel" },
        "search": { "$ref": "#/definitions/CapabilityLevel" },
        "categoryFilter": { "$ref": "#/definitions/CapabilityLevel" },
        "collectionFilter": { "$ref": "#/definitions/CapabilityLevel" },
        "brandFilter": { "$ref": "#/definitions/CapabilityLevel" },
        "sorting": { "$ref": "#/definitions/CapabilityLevel" },
        "cursorPagination": { "$ref": "#/definitions/CapabilityLevel" },
        "productDetail": { "$ref": "#/definitions/CapabilityLevel" },
        "variantSelector": { "$ref": "#/definitions/CapabilityLevel" },
        "gallery": { "$ref": "#/definitions/CapabilityLevel" },
        "stockIndicator": { "$ref": "#/definitions/CapabilityLevel" },
        "relatedProducts": { "$ref": "#/definitions/CapabilityLevel" },
        "cartDrawer": { "$ref": "#/definitions/CapabilityLevel" },
        "cartPage": { "$ref": "#/definitions/CapabilityLevel" },
        "checkoutLayout": { "$ref": "#/definitions/CapabilityLevel" },
        "checkoutMapPicker": { "$ref": "#/definitions/CapabilityLevel" },
        "paymentVoucherUpload": { "$ref": "#/definitions/CapabilityLevel" },
        "taxCalculation": { "$ref": "#/definitions/CapabilityLevel" },
        "shippingCalculation": { "$ref": "#/definitions/CapabilityLevel" },
        "inventoryValidation": { "$ref": "#/definitions/CapabilityLevel" },
        "placeOrder": { "$ref": "#/definitions/CapabilityLevel" },
        "salesModeSwitch": { "$ref": "#/definitions/CapabilityLevel" }
      }
    }
  },
  "definitions": {
    "CapabilityLevel": {
      "type": "string",
      "enum": [
        "required",
        "supported",
        "unsupported",
        "host-controlled",
        "required-when-applicable"
      ]
    }
  }
}
