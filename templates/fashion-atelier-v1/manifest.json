{
  "templateId": "fashion-atelier-v1",
  "name": "Atelier",
  "displayName": "Atelier Fashion",
  "description": "Template e-commerce de moda premium. Identidad visual fija: tipografía Cormorant/Montserrat, negro piedra + acento oro, hero full-bleed, colecciones, destacados, editorial, newsletter, tienda y about.",
  "category": "ecommerce-fashion",
  "version": "1.3.0",
  "schemaVersion": "1.0.0",
  "locale": "es-ES",
  "preview": {
    "path": "/t/atelier",
    "thumbnail": "https://images.unsplash.com/photo-1469334031218-e382a71b716b?w=1200&q=80"
  },
  "runtime": {
    "framework": "nextjs-app-router",
    "mountPath": "/t/atelier",
    "codeEntry": "src/index.ts",
    "packageDir": "templates/fashion-atelier-v1",
    "renderer": "AtelierApp"
  },
  "routes": [
    { "path": "/", "page": "home", "sections": ["hero", "collections", "featured", "editorial", "newsletter"] },
    {
      "path": "/tienda",
      "page": "shop",
      "sections": ["shop"],
      "queryParams": {
        "categoria": "Optional category slug (catalog.categories[].slug). Navbar shopFilter.categorySlug resolves here.",
        "coleccion": "Optional collection slug (catalog.collections[].slug). Navbar shopFilter.collectionSlug resolves here."
      }
    },
    { "path": "/tienda/[slug]", "page": "product", "sections": ["product", "related"] },
    { "path": "/nosotros", "page": "about", "sections": ["about"] }
  ],
  "sections": [
    "hero",
    "collections",
    "featured",
    "editorial",
    "newsletter",
    "shop",
    "about",
    "footer"
  ],
  "capabilities": {
    "catalog": true,
    "collections": true,
    "cart": true,
    "newsletter": true,
    "themeColors": true,
    "fontsConfigurable": false
  },
  "commerce": {
    "mode": "preview-only",
    "contractVersion": null,
    "views": {
      "productListing": true,
      "productDetail": true,
      "cartPage": true,
      "cartDrawer": true,
      "checkoutLayout": true,
      "checkoutPage": true,
      "orderConfirmation": true,
      "accountLogin": true,
      "accountRegister": true,
      "accountDashboard": true
    },
    "capabilities": {
      "productListing": "required",
      "search": "supported",
      "categoryFilter": "supported",
      "collectionFilter": "supported",
      "brandFilter": "supported",
      "sorting": "required",
      "cursorPagination": "required",
      "productDetail": "required",
      "variantSelector": "required-when-applicable",
      "gallery": "supported",
      "stockIndicator": "supported",
      "relatedProducts": "supported",
      "cartDrawer": "supported",
      "cartPage": "supported",
      "checkoutLayout": "supported",
      "checkoutMapPicker": "unsupported",
      "paymentVoucherUpload": "unsupported",
      "taxCalculation": "host-controlled",
      "shippingCalculation": "host-controlled",
      "inventoryValidation": "host-controlled",
      "placeOrder": "host-controlled"
    }
  },
  "mediaSlots": [
    { "id": "hero.image", "section": "hero", "aspect": "full-bleed", "recommendedWidth": 2400 },
    { "id": "collections[].image", "section": "collections", "aspect": "4/5", "count": 3, "recommendedWidth": 1600 },
    { "id": "editorial.image", "section": "editorial", "aspect": "full-bleed", "recommendedWidth": 2400 },
    { "id": "about.bannerImage", "section": "about", "aspect": "wide", "recommendedWidth": 2400 },
    { "id": "products[].image", "section": "catalog", "aspect": "3/4", "recommendedWidth": 1200 },
    { "id": "products[].hoverImage", "section": "catalog", "aspect": "3/4", "optional": true }
  ],
  "constraints": {
    "featuredProductPath": "sections.featured.productIds",
    "collectionIdsPath": "sections.collections.collectionIds",
    "collectionsCount": 3
  },
  "export": {
    "files": [
      "manifest.json",
      "builder.manifest.json",
      "schema.json",
      "defaults.json",
      "package.json",
      "src/",
      "fixtures/",
      "README.md",
      "PROOF.md",
      "BUILD_INFO.json",
      "IMMUTABLE"
    ],
    "command": "npm run template:export -- fashion-atelier-v1",
    "output": "dist/packages/fashion-atelier-v1",
    "consumer": "IA Builder v2 — solo genera/edita Content Payload validado contra schema.json; nunca modifica el código del template."
  }
}
