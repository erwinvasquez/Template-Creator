{
  "templateId": "food-cantina-v1",
  "name": "Cantina",
  "displayName": "Cantina Roja",
  "description": "Template e-commerce de cantina mexicana: tipografía display + sans, rojo y teal, tacos en lanes horizontales, barra de salsas, catering y merch. Solo stock.",
  "category": "ecommerce-food",
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "locale": "es-ES",
  "preview": {
    "path": "/t/cantina",
    "thumbnail": "https://images.unsplash.com/photo-1565299585323-38174c4a6bce?w=1200&q=80"
  },
  "runtime": {
    "framework": "nextjs-app-router",
    "mountPath": "/t/cantina",
    "codeEntry": "src/index.ts",
    "packageDir": "templates/food-cantina-v1",
    "renderer": "CantinaApp"
  },
  "routes": [
    {
      "path": "/",
      "page": "home",
      "sections": [
        "hero",
        "lanes",
        "salsaBar",
        "mercado",
        "fiesta",
        "merch",
        "footer"
      ]
    },
    {
      "path": "/tienda",
      "page": "shop",
      "sections": ["shop"],
      "queryParams": {
        "categoria": "Optional category slug (catalog.categories[].slug). Navbar shopFilter.categorySlug resolves here.",
        "coleccion": "Optional collection slug (catalog.collections[].slug). Navbar shopFilter.collectionSlug resolves here."
      }
    },
    {
      "path": "/tienda/[slug]",
      "page": "product",
      "sections": ["product", "related"]
    },
    {
      "path": "/historia",
      "page": "about",
      "sections": ["about"]
    }
  ],
  "sections": [
    "hero",
    "lanes",
    "salsaBar",
    "mercado",
    "fiesta",
    "merch",
    "shop",
    "about",
    "footer"
  ],
  "capabilities": {
    "catalog": true,
    "collections": true,
    "cart": true,
    "newsletter": false,
    "themeColors": true,
    "fontsConfigurable": false,
    "productDetailPresentation": {
      "supportedFields": [
        "description",
        "collection",
        "category",
        "variants",
        "relatedProducts"
      ]
    }
  },
  "commerce": {
    "mode": "preview-only",
    "contractVersion": null,
    "views": {
      "productListing": true,
      "productDetail": true,
      "cartPage": true,
      "cartDrawer": true,
      "checkoutLayout": true,
      "checkoutPage": false,
      "orderConfirmation": true,
      "orderTracking": true,
      "accountLogin": true,
      "accountRegister": true,
      "accountDashboard": true
    },
    "capabilities": {
      "productListing": "required",
      "search": "supported",
      "categoryFilter": "supported",
      "collectionFilter": "supported",
      "brandFilter": "supported",
      "sorting": "required",
      "cursorPagination": "required",
      "productDetail": "required",
      "variantSelector": "required-when-applicable",
      "gallery": "supported",
      "stockIndicator": "supported",
      "relatedProducts": "supported",
      "cartDrawer": "supported",
      "cartPage": "supported",
      "checkoutLayout": "supported",
      "checkoutMapPicker": "unsupported",
      "paymentVoucherUpload": "unsupported",
      "taxCalculation": "host-controlled",
      "shippingCalculation": "host-controlled",
      "inventoryValidation": "host-controlled",
      "placeOrder": "host-controlled",
      "salesModeSwitch": "unsupported"
    }
  },
  "mediaSlots": [
    {
      "id": "hero.image",
      "section": "hero",
      "aspect": "full-bleed",
      "recommendedWidth": 2400
    },
    {
      "id": "lanes[].image",
      "section": "lanes",
      "aspect": "3/4",
      "count": 4,
      "recommendedWidth": 1600
    },
    {
      "id": "about.bannerImage",
      "section": "about",
      "aspect": "wide",
      "recommendedWidth": 2400
    },
    {
      "id": "products[].image",
      "section": "catalog",
      "aspect": "3/4",
      "recommendedWidth": 1200
    },
    {
      "id": "products[].hoverImage",
      "section": "catalog",
      "aspect": "3/4",
      "optional": true
    }
  ],
  "constraints": {
    "catalogRefs": [
      "sections.mercado.productIds",
      "sections.merch.productIds",
      "sections.lanes.collectionIds"
    ],
    "catalogBindings": [
      {
        "path": "sections.mercado.productIds",
        "kind": "product",
        "sectionId": "mercado",
        "label": { "es": "Destacados barra", "en": "Bar highlights" },
        "maxItems": 8
      },
      {
        "path": "sections.merch.productIds",
        "kind": "product",
        "sectionId": "merch",
        "label": { "es": "Merch", "en": "Merch" },
        "maxItems": 12
      },
      {
        "path": "sections.lanes.collectionIds",
        "kind": "collection",
        "sectionId": "lanes",
        "label": { "es": "Rutas de taco", "en": "Taco routes" },
        "maxItems": 4
      }
    ],
    "commerceFeaturedProductsPath": "sections.mercado.productIds",
    "commerceFeaturedCollectionsPath": "sections.lanes.collectionIds"
  },
  "export": {
    "files": [
      "manifest.json",
      "builder.manifest.json",
      "schema.json",
      "defaults.json",
      "package.json",
      "src/",
      "fixtures/",
      "README.md",
      "PROOF.md",
      "BUILD_INFO.json",
      "IMMUTABLE"
    ],
    "command": "npm run template:export -- food-cantina-v1",
    "output": "dist/packages/food-cantina-v1",
    "consumer": "IA Builder v2 — solo genera/edita Content Payload validado contra schema.json; nunca modifica el código del template."
  }
}
