{
  "templateId": "food-patisserie-v1",
  "name": "Patisserie",
  "displayName": "Pâtisserie Lune",
  "description": "Template e-commerce de pastelería francesa: Rubik + Nunito Sans, crema y ámbar, viennoiserie, temporada, celebraciones y cajas regalo. Pedidos a medida.",
  "category": "ecommerce-food",
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "locale": "es-ES",
  "preview": {
    "path": "/t/patisserie",
    "thumbnail": "https://images.unsplash.com/photo-1555507036-ab1f4038808a?w=1200&q=80"
  },
  "runtime": {
    "framework": "nextjs-app-router",
    "mountPath": "/t/patisserie",
    "codeEntry": "src/index.ts",
    "packageDir": "templates/food-patisserie-v1",
    "renderer": "PatisserieApp"
  },
  "routes": [
    {
      "path": "/",
      "page": "home",
      "sections": [
        "hero",
        "viennoiserie",
        "seasonal",
        "celebration",
        "atelierNote",
        "giftBox",
        "footer"
      ]
    },
    {
      "path": "/boutique",
      "page": "shop",
      "sections": [
        "shop"
      ],
      "queryParams": {
        "categoria": "Optional category slug (catalog.categories[].slug). Navbar shopFilter.categorySlug resolves here.",
        "coleccion": "Optional collection slug (catalog.collections[].slug). Navbar shopFilter.collectionSlug resolves here."
      }
    },
    {
      "path": "/boutique/[slug]",
      "page": "product",
      "sections": [
        "product",
        "related"
      ]
    },
    {
      "path": "/atelier",
      "page": "about",
      "sections": [
        "about"
      ]
    }
  ],
  "sections": [
    "hero",
    "viennoiserie",
    "seasonal",
    "celebration",
    "atelierNote",
    "giftBox",
    "shop",
    "about",
    "footer"
  ],
  "capabilities": {
    "catalog": true,
    "collections": true,
    "cart": true,
    "newsletter": false,
    "themeColors": true,
    "fontsConfigurable": false,
    "productDetailPresentation": {
      "supportedFields": [
        "description",
        "collection",
        "category",
        "variants",
        "relatedProducts"
      ]
    }
  },
  "commerce": {
    "mode": "preview-only",
    "contractVersion": null,
    "views": {
      "productListing": true,
      "productDetail": true,
      "cartPage": true,
      "cartDrawer": true,
      "checkoutLayout": true,
      "checkoutPage": false,
      "orderConfirmation": true,
      "orderTracking": true,
      "accountLogin": true,
      "accountRegister": true,
      "accountDashboard": true
    },
    "capabilities": {
      "productListing": "required",
      "search": "supported",
      "categoryFilter": "supported",
      "collectionFilter": "supported",
      "brandFilter": "supported",
      "sorting": "required",
      "cursorPagination": "required",
      "productDetail": "required",
      "variantSelector": "required-when-applicable",
      "gallery": "supported",
      "stockIndicator": "supported",
      "relatedProducts": "supported",
      "cartDrawer": "supported",
      "cartPage": "supported",
      "checkoutLayout": "supported",
      "checkoutMapPicker": "unsupported",
      "paymentVoucherUpload": "unsupported",
      "taxCalculation": "host-controlled",
      "shippingCalculation": "host-controlled",
      "inventoryValidation": "host-controlled",
      "placeOrder": "host-controlled",
      "salesModeSwitch": "unsupported"
    }
  },
  "mediaSlots": [
    {
      "id": "hero.image",
      "section": "hero",
      "aspect": "full-bleed",
      "recommendedWidth": 2400
    },
    {
      "id": "hero.carousel[]",
      "section": "hero",
      "aspect": "full-bleed",
      "count": 6,
      "recommendedWidth": 2400
    },
    {
      "id": "viennoiserie[].image",
      "section": "viennoiserie",
      "aspect": "3/4",
      "count": 4,
      "recommendedWidth": 1600
    },
    {
      "id": "about.bannerImage",
      "section": "about",
      "aspect": "wide",
      "recommendedWidth": 2400
    },
    {
      "id": "products[].image",
      "section": "catalog",
      "aspect": "3/4",
      "recommendedWidth": 1200
    },
    {
      "id": "products[].hoverImage",
      "section": "catalog",
      "aspect": "3/4",
      "optional": true
    }
  ],
  "constraints": {
    "catalogRefs": [
      "sections.celebration.productIds",
      "sections.giftBox.productIds",
      "sections.viennoiserie.collectionIds"
    ],
    "catalogBindings": [
      {
        "path": "sections.celebration.productIds",
        "kind": "product",
        "sectionId": "celebration",
        "label": {
          "es": "Celebraciones",
          "en": "Celebrations"
        },
        "maxItems": 8
      },
      {
        "path": "sections.giftBox.productIds",
        "kind": "product",
        "sectionId": "giftBox",
        "label": {
          "es": "Cajas regalo",
          "en": "Gift boxes"
        },
        "maxItems": 12
      },
      {
        "path": "sections.viennoiserie.collectionIds",
        "kind": "collection",
        "sectionId": "viennoiserie",
        "label": {
          "es": "Viennoiserie",
          "en": "Viennoiserie"
        },
        "maxItems": 4
      }
    ],
    "commerceFeaturedProductsPath": "sections.celebration.productIds",
    "commerceFeaturedCollectionsPath": "sections.viennoiserie.collectionIds"
  },
  "export": {
    "files": [
      "manifest.json",
      "builder.manifest.json",
      "schema.json",
      "defaults.json",
      "package.json",
      "src/",
      "fixtures/",
      "README.md",
      "PROOF.md",
      "BUILD_INFO.json",
      "IMMUTABLE"
    ],
    "command": "npm run template:export -- food-patisserie-v1",
    "output": "dist/packages/food-patisserie-v1",
    "consumer": "IA Builder v2 — solo genera/edita Content Payload validado contra schema.json; nunca modifica el código del template."
  }
}
