{
  "templateId": "fashion-velvet-v1",
  "name": "Velvet Maison",
  "displayName": "Velvet Maison",
  "description": "E-commerce de moda femenina nocturna y lujo: vestidos de gala, cóctel y lencería de alta costura. Tipografía Cormorant + Montserrat, stone oscuro con acentos oro, hero centrado, marquee de colecciones, craft timeline, grid nocturno y carril Velvet Edit.",
  "category": "ecommerce-fashion",
  "version": "1.0.0",
  "schemaVersion": "1.0.0",
  "locale": "es-ES",
  "preview": {
    "path": "/t/velvet",
    "thumbnail": "https://images.unsplash.com/photo-1539008835657-9e8e9680c956?w=1200&q=80"
  },
  "runtime": {
    "framework": "nextjs-app-router",
    "mountPath": "/t/velvet",
    "codeEntry": "src/index.ts",
    "packageDir": "templates/fashion-velvet-v1",
    "renderer": "VelvetApp"
  },
  "routes": [
    {
      "path": "/",
      "page": "home",
      "sections": [
        "hero",
        "soirees",
        "goldCraft",
        "nocturne",
        "salon",
        "velvetEdit",
        "footer"
      ]
    },
    {
      "path": "/coleccion",
      "page": "shop",
      "sections": [
        "shop"
      ],
      "queryParams": {
        "categoria": "Optional category slug (catalog.categories[].slug). Navbar shopFilter.categorySlug resolves here.",
        "coleccion": "Optional collection slug (catalog.collections[].slug). Navbar shopFilter.collectionSlug resolves here."
      }
    },
    {
      "path": "/coleccion/[slug]",
      "page": "product",
      "sections": [
        "product",
        "related"
      ]
    },
    {
      "path": "/la-maison",
      "page": "about",
      "sections": [
        "about"
      ]
    }
  ],
  "sections": [
    "hero",
    "soirees",
    "goldCraft",
    "nocturne",
    "salon",
    "velvetEdit",
    "shop",
    "about",
    "footer"
  ],
  "capabilities": {
    "catalog": true,
    "collections": true,
    "cart": true,
    "newsletter": false,
    "themeColors": true,
    "fontsConfigurable": false
  },
  "commerce": {
    "mode": "preview-only",
    "contractVersion": null,
    "views": {
      "productListing": true,
      "productDetail": true,
      "cartPage": true,
      "cartDrawer": true,
      "checkoutLayout": true,
      "checkoutPage": false,
      "orderConfirmation": true,
      "orderTracking": true,
      "accountLogin": true,
      "accountRegister": true,
      "accountDashboard": true
    },
    "capabilities": {
      "productListing": "required",
      "search": "supported",
      "categoryFilter": "supported",
      "collectionFilter": "supported",
      "brandFilter": "supported",
      "sorting": "required",
      "cursorPagination": "required",
      "productDetail": "required",
      "variantSelector": "required-when-applicable",
      "gallery": "supported",
      "stockIndicator": "supported",
      "relatedProducts": "supported",
      "cartDrawer": "supported",
      "cartPage": "supported",
      "checkoutLayout": "supported",
      "checkoutMapPicker": "unsupported",
      "paymentVoucherUpload": "unsupported",
      "taxCalculation": "host-controlled",
      "shippingCalculation": "host-controlled",
      "inventoryValidation": "host-controlled",
      "placeOrder": "host-controlled",
      "salesModeSwitch": "unsupported"
    }
  },
  "mediaSlots": [
    {
      "id": "hero.image",
      "section": "hero",
      "aspect": "full-bleed",
      "recommendedWidth": 2400
    },
    {
      "id": "occasions[].image",
      "section": "soirees",
      "aspect": "3/4",
      "count": 4,
      "recommendedWidth": 1600
    },
    {
      "id": "about.bannerImage",
      "section": "about",
      "aspect": "wide",
      "recommendedWidth": 2400
    },
    {
      "id": "products[].image",
      "section": "catalog",
      "aspect": "3/4",
      "recommendedWidth": 1200
    },
    {
      "id": "products[].hoverImage",
      "section": "catalog",
      "aspect": "3/4",
      "optional": true
    }
  ],
  "constraints": {
    "catalogRefs": [
      "sections.nocturne.productIds",
      "sections.velvetEdit.productIds",
      "sections.soirees.collectionIds"
    ],
    "catalogBindings": [
      {
        "path": "sections.nocturne.productIds",
        "kind": "product",
        "sectionId": "nocturne",
        "label": {
          "es": "Selección nocturna",
          "en": "Nocturne selection"
        },
        "maxItems": 8
      },
      {
        "path": "sections.velvetEdit.productIds",
        "kind": "product",
        "sectionId": "velvetEdit",
        "label": {
          "es": "Velvet Edit",
          "en": "Velvet Edit"
        },
        "maxItems": 12
      },
      {
        "path": "sections.soirees.collectionIds",
        "kind": "collection",
        "sectionId": "soirees",
        "label": {
          "es": "Colecciones",
          "en": "Collections"
        },
        "maxItems": 4
      }
    ],
    "commerceFeaturedProductsPath": "sections.nocturne.productIds",
    "commerceFeaturedCollectionsPath": "sections.soirees.collectionIds",
    "signatureProductPath": "sections.nocturne.productIds",
    "occasionIdsPath": "sections.soirees.collectionIds"
  },
  "export": {
    "files": [
      "manifest.json",
      "builder.manifest.json",
      "schema.json",
      "defaults.json",
      "package.json",
      "src/",
      "fixtures/",
      "README.md",
      "PROOF.md",
      "BUILD_INFO.json",
      "IMMUTABLE"
    ],
    "command": "npm run template:export -- fashion-velvet-v1",
    "output": "dist/packages/fashion-velvet-v1",
    "consumer": "IA Builder v2 — solo genera/edita Content Payload validado contra schema.json; nunca modifica el código del template."
  }
}
